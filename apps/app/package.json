{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-types": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:feedback": "bun test src/lib/domain/advancement.test.ts src/lib/domain/scorecard.test.ts",
    "test:navigation": "bun test src/components/layout/nav-config.test.ts",
    "test:queue": "bun --env-file=.env.local --conditions=react-server test src/lib/queries/queue.integration.test.ts",
    "test:scorecards": "bun --env-file=.env.local --conditions=react-server test src/lib/queries/scorecards.integration.test.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun --conditions=react-server run src/db/seed.ts",
    "auth:generate": "bun run node_modules/auth/dist/index.mjs generate",
    "test:notifications": "bun test src/lib/notifications/templates.test.ts src/lib/notifications/transport.test.ts",
    "test:decisions": "bun --env-file=.env.local --conditions=react-server test src/lib/services/application-decisions.integration.test.ts",
    "test:public-apply": "bun --env-file=.env.local --conditions=react-server test src/lib/services/public-applications.integration.test.ts",
    "test:unit": "bun test src/lib/domain src/lib/notifications src/lib/validation src/components/layout",
    "test:pipeline": "bun --env-file=.env.local --conditions=react-server test src/lib/queries/pipeline.integration.test.ts",
    "test:analytics": "bun --env-file=.env.local --conditions=react-server test src/lib/queries/analytics.integration.test.ts",
    "test:criteria": "bun --env-file=.env.local --conditions=react-server test src/lib/queries/criteria.integration.test.ts",
    "test:all": "bun run test:unit && bun run test:decisions && bun run test:public-apply && bun run test:queue && bun run test:scorecards && bun run test:pipeline && bun run test:analytics && bun run test:criteria && bun run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
