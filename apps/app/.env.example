# Copy this file to apps/app/.env.local. That is the ONLY env file the app
# reads: Next.js loads .env* from the app directory, so a repo-root .env is
# ignored (drizzle-kit and the test scripts read the same apps/app/.env.local).
# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# Copy BOTH strings from Supabase Dashboard -> Connect. Do not hand-assemble
# them; the pooler host prefix (aws-0- / aws-1-) varies by project.
# ---------------------------------------------------------------------------
# Runtime: TRANSACTION pooler, port 6543. Requires prepare:false in the driver.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres"
# Migrations / drizzle-kit / studio: SESSION pooler, port 5432.
# DDL and advisory locks need a session connection.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# ---------------------------------------------------------------------------
# Supabase Storage (candidate CVs)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # SERVER ONLY. Never prefix NEXT_PUBLIC_.
SUPABASE_STORAGE_BUCKET="cv"

# ---------------------------------------------------------------------------
# Auth (better-auth)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="<openssl rand -base64 32>"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (Resend) — optional. With NOTIFICATIONS_ENABLED=false or no
# RESEND_API_KEY every message is still recorded (status "simulated") with its
# rendered body and shown on the application's history and Emails panel.
# See README → "Email modes".
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"        # bare address; sender reads "<company> Hiring <EMAIL_FROM>"
NEXT_PUBLIC_COMPANY_NAME="Docket"         # used in the sender name, careers header and email shell
NEXT_PUBLIC_CAREERS_FOOTER=""             # optional footer line on the public careers pages
NOTIFICATIONS_ENABLED="false"
DEMO_EMAIL_REDIRECT=""    # dev: rewrite every recipient to this inbox; original kept in metadata

